# Local variables declared alone in a compound statement, with their storage and type facts.
# "trivial": arithmetic, pointer, enum, arrays of those, or a record whose default constructor,
# fields, destructor, and every base are trivial (covers FixedArray and the classes derived from it).
# "ctor": the initializer passes arguments to a user-provided constructor.
# "trivialdtor": a "simple" type, or a record with no user-provided or virtual destructor whose
# fields are "simple" and whose bases are the same.
set output dump
set bind-root false
let simple qualType(hasUnqualifiedDesugaredType(anyOf(builtinType(), pointerType(), enumType(), constantArrayType(hasElementType(hasUnqualifiedDesugaredType(anyOf(builtinType(), pointerType(), enumType())))))))
let flat cxxRecordDecl(unless(has(fieldDecl(unless(hasType(simple))))), unless(has(fieldDecl(hasInClassInitializer(anything())))), unless(has(cxxConstructorDecl(isDefaultConstructor(), isUserProvided()))), unless(has(cxxMethodDecl(isVirtual()))), unless(has(cxxDestructorDecl(isUserProvided()))))
let trivialRecord cxxRecordDecl(flat, unless(isDerivedFrom(cxxRecordDecl(unless(flat)))))
let dtorFlat cxxRecordDecl(unless(has(cxxDestructorDecl(anyOf(isUserProvided(), isVirtual())))), unless(has(fieldDecl(unless(hasType(simple))))))
let trivialDtorRecord cxxRecordDecl(dtorFlat, unless(isDerivedFrom(cxxRecordDecl(unless(dtorFlat)))))
let local varDecl(unless(isExpansionInSystemHeader()), unless(decompositionDecl()), hasParent(declStmt(hasSingleDecl(anything()), hasParent(compoundStmt()))))
match varDecl(local).bind("local")
match varDecl(local, anyOf(isStaticLocal(), hasThreadStorageDuration())).bind("static")
match varDecl(local, anyOf(hasType(simple), hasType(hasUnqualifiedDesugaredType(recordType(hasDeclaration(trivialRecord)))))).bind("trivial")
match varDecl(local, hasInitializer(ignoringImplicit(cxxConstructExpr(unless(argumentCountIs(0)), hasDeclaration(cxxConstructorDecl(isUserProvided())))))).bind("ctor")
match varDecl(local, anyOf(hasType(simple), hasType(hasUnqualifiedDesugaredType(recordType(hasDeclaration(trivialDtorRecord)))))).bind("trivialdtor")
