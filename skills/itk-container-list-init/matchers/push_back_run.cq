# A default-constructed container local whose block holds an append call.
set output dump
set bind-root false
match varDecl(
  hasParent(declStmt(hasParent(compoundStmt(hasAnySubstatement(expr(ignoringImplicit(
    cxxMemberCallExpr(callee(cxxMethodDecl(hasAnyName("push_back", "emplace_back"))))))))))),
  hasInitializer(cxxConstructExpr(argumentCountIs(0))),
  hasType(hasUnqualifiedDesugaredType(recordType(hasDeclaration(namedDecl(
    hasAnyName("::std::vector", "::std::array", "::itk::Array", "::vnl_vector"))))))).bind("push_back_run")
