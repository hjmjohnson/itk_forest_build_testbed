# A default-constructed or literal-sized container local whose block holds a subscript assignment.
set output dump
set bind-root false
match varDecl(
  hasParent(declStmt(hasParent(compoundStmt(hasAnySubstatement(expr(ignoringImplicit(anyOf(
    binaryOperator(isAssignmentOperator(), hasLHS(ignoringParenImpCasts(
      cxxOperatorCallExpr(hasOverloadedOperatorName("[]"))))),
    cxxOperatorCallExpr(hasOverloadedOperatorName("="), hasArgument(0, ignoringParenImpCasts(
      cxxOperatorCallExpr(hasOverloadedOperatorName("[]"))))))))))))),
  hasAutomaticStorageDuration(),
  hasInitializer(cxxConstructExpr(anyOf(argumentCountIs(0),
    hasArgument(0, ignoringImplicit(integerLiteral()))))),
  hasType(hasUnqualifiedDesugaredType(recordType(hasDeclaration(namedDecl(
    hasAnyName("::std::vector", "::std::array", "::itk::Array", "::vnl_vector"))))))).bind("index_assign_run")
