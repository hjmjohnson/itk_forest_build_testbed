# The same local when its class has a compile-time size, which itk::MakeFilled requires.
set output dump
set bind-root false
match varDecl(
  hasAutomaticStorageDuration(),
  hasInitializer(cxxConstructExpr(argumentCountIs(0))),
  hasType(hasUnqualifiedDesugaredType(recordType(hasDeclaration(cxxRecordDecl(anyOf(
    isSameOrDerivedFrom(cxxRecordDecl(hasName("::itk::FixedArray"))),
    hasAnyName("::itk::Size", "::itk::Index", "::itk::Offset", "::std::array"),
    hasMethod(cxxMethodDecl(hasName("size"), isConstexpr()))))))))).bind("fixed_size")
