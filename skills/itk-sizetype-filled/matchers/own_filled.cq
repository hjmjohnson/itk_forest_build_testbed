# The same local when its own class declares a static Filled, which returns that class.
set output dump
set bind-root false
match varDecl(
  hasAutomaticStorageDuration(),
  hasInitializer(cxxConstructExpr(argumentCountIs(0))),
  hasType(hasUnqualifiedDesugaredType(recordType(hasDeclaration(cxxRecordDecl(
    hasMethod(cxxMethodDecl(hasName("Filled"), isStaticStorageClass())))))))).bind("own_filled")
