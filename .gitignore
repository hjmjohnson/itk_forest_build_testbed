# Machine-local testbed. Track ONLY the kit: bin/ (scripts), docs/ (md library),
# pixi config, CLAUDE.md, and build_forest/README.md. Everything else — the
# build_forest/ artifacts (source checkouts + *-build trees), the pixi env
# (.pixi/), abandoned root-level checkouts, and Claude scratch (.remember/,
# .memsearch/, .devlocal/) — is regenerated by `pixi run checkout` + a build.
/*
!/.gitignore
# Line-ending policy (eol=lf). MUST be tracked: it is what stops a Windows
# clone from committing CRLF and breaking bash/CMake on macOS and Linux.
!/.gitattributes
!/CLAUDE.md
!/README.md
!/CATALOG.md
!/pixi.toml
!/pixi.lock
!/config.json.in
!/versions.toml
!/bin/
!/docs/
!/skills/
!/Maintenance/
!/utilities/
# Committed CMakePresets fragments live here. Generated CMakeUserPresets.json in
# consumer forests stays ignored (global rule + /build_forest*). Keep smoke build out.
!/cmake/
/cmake/presets/.smoke/build/

# Node-local generated config (config.json.in -> config.sh via bin/config.py).
# Already excluded by /*, but listed explicitly so intent is clear; never track.
/config.sh
/config.json

# build_forest/: track only its README; all build artifacts stay out of git.
!/build_forest/
/build_forest/*
!/build_forest/README.md
__pycache__/
*.pyc
